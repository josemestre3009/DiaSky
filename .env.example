# Application
DATABASE_URL=postgresql+psycopg://diask:change-me@postgres:5432/diask
ADMIN_TOKEN=replace-with-a-long-random-token
WEBHOOK_SECRET=replace-with-a-long-random-token
# Use this when Evolution cannot send X-Webhook-Secret. Generate with openssl rand -hex 32.
WEBHOOK_PATH_TOKEN=replace-with-a-long-random-token
TIMEZONE=America/Bogota

# Evolution cloud instance
EVOLUTION_API_URL=https://evo.skypass.com.co
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_SEND_TEXT_PATH=/message/sendText/{instance}
OPERATION_GROUP_JIDS=1234567890-123456@g.us,9876543210-654321@g.us
AUTHORIZED_CREATOR_JIDS=573001234567@s.whatsapp.net,573009876543@s.whatsapp.net
REPORT_RECIPIENT_JID=573001234567@s.whatsapp.net

# OpenRouter. Leave empty to retain ambiguous events for review.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_MIN_CONFIDENCE=0.80

# Local Postgres only. Do not use these values in production.
POSTGRES_DB=diask
POSTGRES_USER=diask
POSTGRES_PASSWORD=change-me
